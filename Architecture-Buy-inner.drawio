width="520" height="67" as="geometry"/></mxCell><mxCell id="c39" value="get_signup_stats()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c38"><mxGeometry x="4" y="28" width="250" height="21" as="geometry"/></mxCell><mxCell id="c40" value="admin_prepare_user_deletion()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c38"><mxGeometry x="260" y="28" width="250" height="21" as="geometry"/></mxCell><mxCell id="c41" value="Fonctions — Triggers et garde-fous (9)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;startSize=26;fillColor=#C5E0B4;" vertex="1" parent="1"><mxGeometry x="580" y="682" width="520" height="119" as="geometry"/></mxCell><mxCell id="c42" value="admins_keep_one_super()&lt;br&gt;companies_sync_owner()&lt;br&gt;news_posts_touch()&lt;br&gt;news_suggestions_touch()&lt;br&gt;product_submissions_free_limit()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c41"><mxGeometry x="4" y="28" width="250" height="73" as="geometry"/></mxCell><mxCell id="c43" value="service_requests_guard()&lt;br&gt;_company_seat_limit()&lt;br&gt;_company_seats_used()&lt;br&gt;_free_product_limit()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c41"><mxGeometry x="260" y="28" width="250" height="73" as="geometry"/></mxCell><mxCell id="c44" value="Auth" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;startSize=26;" vertex="1" parent="1"><mxGeometry x="1160" y="80" width="420" height="200" as="geometry"/></mxCell><mxCell id="c45" value="• Comptes e-mail + mot de passe : acheteurs, fournisseurs, admins&lt;br&gt;• MFA TOTP : facteur vérifié, niveau aal2 exigé pour l’admin (supabase_enforce_mfa_aal2.sql)&lt;br&gt;• E-mail de confirmation avec redirect_to vers le site (Site URL = https://www.buy-inner.com)&lt;br&gt;• Liens de récupération générés par le Worker (admin API)&lt;br&gt;• Appelé via /api/auth (proxy)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;" vertex="1" parent="c44"><mxGeometry x="4" y="28" width="412" height="168" as="geometry"/></mxCell><mxCell id="c46" value="Storage" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;startSize=26;" vertex="1" parent="1"><mxGeometry x="1160" y="296" width="420" height="110" as="geometry"/></mxCell><mxCell id="c47" value="• product-images : photos de produits (submit.js, supplier.js)&lt;br&gt;• rfq-attachments : pièces jointes des appels d’offres (rfq.js)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;" vertex="1" parent="c46"><mxGeometry x="4" y="28" width="412" height="76" as="geometry"/></mxCell><mxCell id="c48" value="Qui accède à quoi" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#F8CECC;strokeColor=#B85450;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;startSize=26;" vertex="1" parent="1"><mxGeometry x="1160" y="422" width="420" height="270" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Navigateur (clé anon publique)&lt;/b&gt; : lecture catalogue via RPC paginées, actus via get_news_page, écritures soumises à RLS (soumission, lead, RFQ…).&lt;br&gt;&lt;br&gt;&lt;b&gt;Utilisateur connecté (JWT)&lt;/b&gt; : ses propres lignes (profil, équipe, produits de son entreprise), RFQ selon Premium / NDA.&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin (JWT + table admins + MFA)&lt;/b&gt; : back-office complet, journal d’audit.&lt;br&gt;&lt;br&gt;&lt;b&gt;Worker (service_role)&lt;/b&gt; : actions d’administration, rendu serveur, écriture de news_suggestions, mise à jour du statut Premium. Clé jamais exposée au navigateur." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;" vertex="1" parent="c48"><mxGeometry x="4" y="28" width="412" height="238" as="geometry"/></mxCell><mxCell id="c50" value="Dossier backend/ du dépôt" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;startSize=26;" vertex="1" parent="1"><mxGeometry x="1160" y="708" width="420" height="150" as="geometry"/></mxCell><mxCell id="c51" value="153 scripts SQL : schéma (supabase_admin_setup, supplier_accounts, rfq_system…), sécurité (lock_base_tables, enforce_mfa_aal2, grants), actualités (news, news_en, news_suggestions), données (ajouts d’entreprises, fiches produit, traductions EN, géocodage) et correctifs. Exécutés à la main dans le SQL editor ; jamais servis au public." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;" vertex="1" parent="c50"><mxGeometry x="4" y="28" width="412" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="6 · Flux clés" id="p6"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Flux clés de bout en bout&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Six parcours qui traversent le site, Cloudflare, Supabase et les services externes.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="52" as="geometry"/></mxCell><mxCell id="c3" value="1 · Une fiche entreprise lue par un robot ou un visiteur" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1740" height="160" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1. Requête&lt;/b&gt;&lt;br&gt;GET /pages/entreprise.html?id=…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2. Route Worker&lt;/b&gt;&lt;br&gt;handleEntityPage (cache 10 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3. GitHub Pages&lt;/b&gt;&lt;br&gt;fetch du gabarit HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4. Supabase&lt;/b&gt;&lt;br&gt;RPC get_company_by_id + produits (service_role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5. HTMLRewriter&lt;/b&gt;&lt;br&gt;injecte texte, JSON-LD, hreflang, titre" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="1140" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6. Navigateur&lt;/b&gt;&lt;br&gt;entreprise.js remplace le rendu, sans doubler le JSON-LD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c3"><mxGeometry x="1420" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="2 · Inscription et confirmation de compte" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1740" height="160" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;1. Formulaire&lt;/b&gt;&lt;br&gt;buyer.js / supplier.js : signup avec redirect_to" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;2. Proxy&lt;/b&gt;&lt;br&gt;/api/auth/v1/signup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;3. Supabase Auth&lt;/b&gt;&lt;br&gt;crée le compte, envoie l’e-mail de confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;4. Utilisateur&lt;/b&gt;&lt;br&gt;clique sur le lien reçu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;5. Retour sur le site&lt;/b&gt;&lt;br&gt;handleSignupConfirmationLanding → session ouverte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="1140" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;6. Profil&lt;/b&gt;&lt;br&gt;buyer_profiles ou fiche entreprise liée au compte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c15"><mxGeometry x="1420" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="3 · Abonnement Premium" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="1740" height="160" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;1. Espace fournisseur&lt;/b&gt;&lt;br&gt;supplier.js : bouton Passer en Premium" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;2. Worker&lt;/b&gt;&lt;br&gt;/api/create-checkout-session (JWT vérifié)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;3. Stripe Checkout&lt;/b&gt;&lt;br&gt;paiement de l’abonnement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;4. Stripe webhook&lt;/b&gt;&lt;br&gt;checkout.session.completed → /api/stripe-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;5. Worker&lt;/b&gt;&lt;br&gt;verifyStripeSignature → patchCompanies(premium = true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="1140" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;6. Resend&lt;/b&gt;&lt;br&gt;e-mail « Premium activé »" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c27"><mxGeometry x="1420" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="4 · Actualités : de la routine à la publication" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="2020" height="160" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;1. Routine Claude&lt;/b&gt;&lt;br&gt;veille web, rédige 3 propositions FR+EN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;2. Worker&lt;/b&gt;&lt;br&gt;POST /api/news-ingest (clé, validation, plafonds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;3. news_suggestions&lt;/b&gt;&lt;br&gt;file d’attente, statut new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;4. Admin &amp;gt; Actualités&lt;/b&gt;&lt;br&gt;admin-news.js : choisir, modifier FR+EN, publier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;5. news_posts&lt;/b&gt;&lt;br&gt;FR + EN obligatoires, planification possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="1140" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;6. Pages publiques&lt;/b&gt;&lt;br&gt;/blog/actus.html, /en/news.html, RSS, sitemaps (cache 60 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="1420" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;7. LinkedIn&lt;/b&gt;&lt;br&gt;kit de post prêt + bouton partager, avec utm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c39"><mxGeometry x="1700" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c45" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="5 · Demande de contact ou de devis" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1180" height="160" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;1. Formulaire&lt;/b&gt;&lt;br&gt;leads.js (contact fournisseur) ou service-request.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c53"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;2. Supabase&lt;/b&gt;&lt;br&gt;table leads ou service_requests (RLS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c53"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;3. Web3Forms&lt;/b&gt;&lt;br&gt;e-mail au fondateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c53"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;4. Admin&lt;/b&gt;&lt;br&gt;badge et liste des demandes dans admin.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c53"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c55" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c56" target="c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="6 · Mot de passe oublié" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#999999;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=13;startSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1460" height="160" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;1. Formulaire&lt;/b&gt;&lt;br&gt;forgot-password.js sous la connexion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c61"><mxGeometry x="20" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;2. Worker&lt;/b&gt;&lt;br&gt;/api/request-password-reset : réponse identique si compte inconnu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c61"><mxGeometry x="300" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;3. Auth admin&lt;/b&gt;&lt;br&gt;generateRecoveryData : jeton de récupération" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c61"><mxGeometry x="580" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;4. Resend&lt;/b&gt;&lt;br&gt;e-mail avec lien personnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c61"><mxGeometry x="860" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;5. Nouveau mot de passe&lt;/b&gt;&lt;br&gt;pages/nouveau-mot-de-passe.html (reset-password.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;spacingTop=6;" vertex="1" parent="c61"><mxGeometry x="1140" y="48" width="230" height="90" as="geometry"/></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c62" target="c63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c63" target="c64"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c64" target="c65"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c65" target="c66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="7 · Comprendre le Worker" id="p7"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;À quoi sert le Worker ?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Un seul Worker (cloudflare/supabase-proxy-worker.js) : la partie « serveur » du site, hébergée par Cloudflare, sans serveur à gérer.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="52" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Sans Worker : GitHub Pages seul&lt;/b&gt;&lt;br&gt;• ne sert que des fichiers (HTML, JS, CSS)&lt;br&gt;• ne peut exécuter aucun code de son côté&lt;br&gt;• ne peut garder aucun secret : tout ce qui est dans les fichiers est lisible par tout le monde&lt;br&gt;&lt;br&gt;&lt;b&gt;Donc impossible :&lt;/b&gt; envoyer des e-mails (clé Resend), encaisser un paiement (clé Stripe), agir en administrateur sur la base, donner aux robots des pages complètes alors que le contenu se charge en JavaScript." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=11;arcSize=5;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="560" height="170" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Avec le Worker&lt;/b&gt;&lt;br&gt;Un petit programme qui s’exécute chez Cloudflare, devant le site, sur les chemins pour lesquels une route a été créée.&lt;br&gt;&lt;br&gt;• il connaît les secrets (clés Resend, Stripe, service_role, ingestion), jamais envoyés au navigateur&lt;br&gt;• il vérifie qui fait la demande avant toute action sensible&lt;br&gt;• il peut compléter une page avant de la renvoyer, et garder le résultat en mémoire (cache)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="560" height="170" as="geometry"/></mxCell><mxCell id="c5" value="on ajoute le Worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="Le trajet d’une requête" style="text;html=1;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="275" width="400" height="24" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Navigateur ou robot&lt;/b&gt;&lt;br&gt;demande une URL de buy-inner.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="190" height="70" as="geometry"/></mxCell><mxCell id="c8" value="Cloudflare :&lt;br&gt;ce chemin a-t-il&lt;br&gt;une route ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="315" width="230" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;GitHub Pages&lt;/b&gt;&lt;br&gt;sert le fichier tel quel (HTML, JS, CSS, images)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Le Worker s’exécute&lt;/b&gt;&lt;br&gt;lit l’URL, décide quoi faire selon le chemin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFD9A8;" vertex="1" parent="1"><mxGeometry x="590" y="400" width="260" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;A · Action sécurisée&lt;/b&gt;&lt;br&gt;/api/send-email, /api/create-checkout-session, /api/stripe-webhook, /api/admin-users, /api/request-password-reset, /api/news-ingest…&lt;br&gt;&lt;i&gt;utilise les secrets, vérifie l’identité, puis appelle Resend, Stripe ou Supabase (service_role)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="930" y="280" width="420" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;B · Relais vers Supabase&lt;/b&gt;&lt;br&gt;/api/rest, /api/auth, /api/storage&lt;br&gt;&lt;i&gt;le site ne parle jamais directement à Supabase ; le Worker retransmet et nettoie la réponse (retire Content-Range : correctif du wifi d’entreprise)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="930" y="405" width="420" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;C · Page enrichie (SEO / GEO)&lt;/b&gt;&lt;br&gt;fiches entreprise et produit, annuaire, catalogue, actualités, sitemaps, RSS&lt;br&gt;&lt;i&gt;récupère la coquille HTML sur GitHub Pages + les données Supabase, ajoute texte, JSON-LD et hreflang, garde en cache (10 min, 1 h ou 60 s)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="930" y="520" width="420" height="115" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#555555;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Si une route manque dans Cloudflare, la page est servie sans enrichissement et le Worker ne s’exécute pas." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="270" y="450" width="300" height="50" as="geometry"/></mxCell><mxCell id="c21" value="Les quatre rôles" style="text;html=1;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="665" width="400" height="24" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;1 · Garder les secrets et agir&lt;/b&gt;&lt;br&gt;Paiement Stripe, e-mails Resend, mot de passe oublié, gestion des utilisateurs par l’admin, dépôt des propositions de la routine. Le navigateur ne voit jamais les clés." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="320" height="140" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;2 · Relayer vers Supabase&lt;/b&gt;&lt;br&gt;Tout passe par buy-inner.com/api. Un seul point où corriger un problème réseau, et la base n’est jamais appelée directement par le site." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="355" y="700" width="320" height="140" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;3 · Rendre les pages lisibles&lt;/b&gt;&lt;br&gt;Google, ChatGPT, LinkedIn reçoivent une page déjà remplie (texte, JSON-LD, langues). Les visiteurs, eux, voient la même page, puis le JS prend le relais." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="690" y="700" width="320" height="140" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;4 · Accélérer&lt;/b&gt;&lt;br&gt;Le résultat des pages enrichies est gardé en mémoire (Cache API) : moins d’appels à Supabase, pages plus rapides, coûts nuls au trafic actuel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1025" y="700" width="320" height="140" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Ce que le Worker ne fait pas&lt;/b&gt;&lt;br&gt;• il ne stocke pas les données : elles sont dans Supabase&lt;br&gt;• il n’héberge pas le site : c’est GitHub Pages&lt;br&gt;• il n’a pas d’interface : il traite des requêtes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="660" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;À retenir pour le déploiement&lt;/b&gt;&lt;br&gt;• une route Cloudflare par chemin concerné, ajoutée à la main&lt;br&gt;• secrets gérés dans les réglages du Worker, séparés du code&lt;br&gt;• ordre : pousser le site → attendre GitHub Pages → purger le cache → redéployer le Worker&lt;br&gt;• l’offre gratuite de Cloudflare couvre le trafic actuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="700" y="870" width="660" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="1 · Vue d&#x27;ensemble" id="p1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Buy-inner.com — architecture globale&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;Site statique (GitHub Pages) derrière Cloudflare (Worker), données et comptes dans Supabase, services externes. Bleu = site · orange = Cloudflare · vert = Supabase · violet = services externes · jaune = personnes · rouge = sécurité.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="52" as="geometry"/></mxCell><mxCell id="c3" value="Visiteurs et comptes" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFF2CC;strokeColor=#D6B656;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="330" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Visiteur anonyme&lt;/b&gt;&lt;br&gt;FR / EN, depuis le navigateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="10" y="40" width="210" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Acheteur connecté&lt;/b&gt;&lt;br&gt;compte acheteur, RFQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="10" y="110" width="210" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Fournisseur connecté&lt;/b&gt;&lt;br&gt;espace fournisseur, équipe, Premium" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="10" y="180" width="210" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Admin Buy-inner&lt;/b&gt;&lt;br&gt;back-office, MFA TOTP obligatoire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c3"><mxGeometry x="10" y="250" width="210" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Robots et moteurs IA&lt;/b&gt;&lt;br&gt;Googlebot, Bingbot, GPTBot, ClaudeBot, LinkedInBot…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="230" height="69" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Routine Claude (cloud)&lt;/b&gt;&lt;br&gt;lun / mer / ven / sam à 6 h : veille web, 2 posts LinkedIn, 3 propositions d’actus FR+EN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="539" width="230" height="84" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Fondateurs&lt;/b&gt;&lt;br&gt;Damien Poix (CEO) et Faez Abdou (CTO) : valident les actus dans l’admin, postent sur LinkedIn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="643" width="230" height="84" as="geometry"/></mxCell><mxCell id="c11" value="CLOUDFLARE  (DNS · proxy · Worker · Cache)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="860" height="748" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;DNS + proxy HTTPS&lt;/b&gt;&lt;br&gt;buy-inner.com / www.buy-inner.com → CNAME vers GitHub Pages (fichier CNAME du dépôt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c11"><mxGeometry x="20" y="42" width="820" height="55" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Routes du Worker&lt;/b&gt; (une route par chemin, à ajouter à la main dans Cloudflare)&lt;br&gt;/pages/entreprise.html · /pages/produit.html · /en/company.html · /en/product.html · /pages/annuaire|catalogue|prestations|systemiers.html · /blog/actus*.html|xml · /en/news*.html|xml · /sitemap-fr.xml · /sitemap-en.xml · /api/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c11"><mxGeometry x="20" y="107" width="820" height="69" as="geometry"/></mxCell><mxCell id="c14" value="Worker  cloudflare/supabase-proxy-worker.js  (78 fonctions)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fillColor=#FFD9A8;" vertex="1" parent="c11"><mxGeometry x="20" y="188" width="820" height="433" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Rendu côté serveur (HTMLRewriter)&lt;/b&gt;&lt;br&gt;handleEntityPage → fiches entreprise et produit&lt;br&gt;handleListPage → annuaire, catalogue, prestations, systémiers&lt;br&gt;handleNewsList / handleNewsArticle → actualités FR et EN&lt;br&gt;Injecte contenu texte, JSON-LD, hreflang, titres : lisible par les robots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="14" y="38" width="390" height="127" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Sitemaps et flux&lt;/b&gt;&lt;br&gt;handleSitemap → /sitemap-fr.xml, /sitemap-en.xml (entités + actus)&lt;br&gt;handleNewsRss → /blog/actus.xml, /en/news.xml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="14" y="175" width="390" height="84" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Sécurité&lt;/b&gt;&lt;br&gt;authenticateAdmin / requireAdmin (JWT + table admins) · auditAdminAction (journal) · verifyStripeSignature · newsKeyOk (SHA-256) · CORS · plafonds de dépôt (5 par appel, 20 par heure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="14" y="269" width="390" height="98" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;API métier (POST)&lt;/b&gt;&lt;br&gt;/api/send-email · /api/send-invite-email&lt;br&gt;/api/request-password-reset · /api/admin-users&lt;br&gt;/api/create-checkout-session · /api/stripe-webhook&lt;br&gt;/api/news-ingest (clé Bearer) · /api/_diag (diagnostic réseau)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="416" y="38" width="390" height="113" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Proxy Supabase&lt;/b&gt;&lt;br&gt;/api/rest/v1/…, /api/auth/v1/…, /api/storage/v1/… → SUPABASE_ORIGIN&lt;br&gt;Supprime Content-Range et Accept-Ranges (proxys d’entreprise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="416" y="161" width="390" height="98" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Accès service_role&lt;/b&gt;&lt;br&gt;serviceFetch, authAdminFetch, patchCompanies… : clé réservée au Worker, jamais envoyée au navigateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="416" y="269" width="390" height="69" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;E-mails transactionnels&lt;/b&gt;&lt;br&gt;sendTemplateEmail → sendViaResend : confirmation de soumission, invitation d’équipe, mot de passe oublié, Premium activé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c14"><mxGeometry x="416" y="348" width="390" height="69" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Cache API&lt;/b&gt;&lt;br&gt;fiches 10 min · listes et sitemaps 1 h · actus 60 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="c11"><mxGeometry x="20" y="633" width="405" height="69" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Secrets du Worker&lt;/b&gt;&lt;br&gt;RESEND_API_KEY · STRIPE_SECRET_KEY · STRIPE_WEBHOOK_SECRET · STRIPE_PRICE_ID · SUPABASE_SERVICE_ROLE_KEY · NEWS_INGEST_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="c11"><mxGeometry x="435" y="633" width="405" height="69" as="geometry"/></mxCell><mxCell id="c24" value="Ordre de déploiement : pousser le site → attendre GitHub Pages (~10 min) → purger le cache Cloudflare → redéployer le Worker" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fillColor=none;" vertex="1" parent="c11"><mxGeometry x="20" y="712" width="820" height="26" as="geometry"/></mxCell><mxCell id="c25" value="GITHUB PAGES  — dépôt poixdamienpro.github.io (branche main, déploiement automatique)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#F5F5F5;strokeColor=#666666;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="898" width="860" height="384" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Pages HTML&lt;/b&gt;&lt;br&gt;pages/ (40) FR · en/ (32) EN · blog/ (3) · racine : index, mentions-legales, cgv, politique-confidentialite · partials/ (nav, footer, modals chargés par layout.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c25"><mxGeometry x="20" y="42" width="820" height="69" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;JavaScript&lt;/b&gt;&lt;br&gt;js/ : 12 fichiers socle (data, i18n, api, layout, buyer, news, leads, modal, chips, analytics, animations, forgot-password) + js/pages/ : 19 fichiers par page. Détail dans l’onglet 2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c25"><mxGeometry x="20" y="121" width="820" height="69" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Styles et médias&lt;/b&gt;&lt;br&gt;css/styles.css · assets/ (11 : photos équipe, logos locaux, icônes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="c25"><mxGeometry x="20" y="200" width="405" height="69" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;SEO / GEO&lt;/b&gt;&lt;br&gt;sitemap.xml · robots.txt · llms.txt · data.json · BingSiteAuth.xml · google57….html" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;" vertex="1" parent="c25"><mxGeometry x="435" y="200" width="405" height="69" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;backend/&lt;/b&gt; — 153 scripts SQL (schéma, RLS, RPC, données, correctifs) : jamais servis au public, exécutés à la main dans le SQL editor de Supabase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;" vertex="1" parent="c25"><mxGeometry x="20" y="279" width="820" height="55" as="geometry"/></mxCell><mxCell id="c31" value="Ce que sert GitHub Pages : tout le HTML, JS et CSS. Les pages dynamiques (fiches, listes, actus) y sont des « coquilles » que le Worker enrichit." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fillColor=none;" vertex="1" parent="c25"><mxGeometry x="20" y="344" width="820" height="30" as="geometry"/></mxCell><mxCell id="c32" value="SUPABASE  (projet pzejxwrtsglmiitbhpjr)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1450" y="100" width="560" height="697" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;comptes e-mail + mot de passe (acheteurs, fournisseurs, admins) · MFA TOTP (niveau aal2 exigé pour l’admin) · e-mail de confirmation avec redirect_to vers le site · liens de récupération générés par le Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="42" width="520" height="84" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;API REST PostgREST + RPC&lt;/b&gt;&lt;br&gt;clé anon publique (lecture limitée par RLS) · clé service_role (Worker uniquement) · plafond de 50 lignes par requête → pagination (fetchAllPaged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="136" width="520" height="69" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Base Postgres — 22 tables versionnées + tables de base&lt;/b&gt;&lt;br&gt;Catalogue : companies, products, product_specs, product_certs, company_tags, company_product_categories, company_industries, company_locations, product_characteristics, product_tags (+ vues v_companies_summary, v_products_full)&lt;br&gt;Comptes : admins, company_members, company_invites, company_claims, buyer_profiles, password_reset_requests, admin_audit_log&lt;br&gt;Demandes : product_submissions, leads, service_requests, rfq_dossiers, rfq_responses, rfq_nda_acceptances, rfq_custom_nda_signatures&lt;br&gt;Contenu : news_posts (FR+EN), news_suggestions (file d’attente de la routine)&lt;br&gt;Mesure : site_page_views, entity_views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="215" width="520" height="171" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;35 fonctions SQL + 6 triggers&lt;/b&gt;&lt;br&gt;RPC SECURITY DEFINER (get_companies_page, get_products_page, get_news_page, invite_company_member, get_rfq_dossiers_page…), aides RLS (is_admin, is_company_member, is_premium_member…), garde-fous (limite de produits gratuits, un super-admin minimum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="396" width="520" height="98" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;buckets product-images et rfq-attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="504" width="520" height="55" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Règles de sécurité&lt;/b&gt;&lt;br&gt;RLS sur toutes les tables · droits par défaut révoqués puis GRANT explicites · données publiques limitées aux entreprises visibles · accès admin = table admins + MFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=11;fillColor=#FFFFFF;" vertex="1" parent="c32"><mxGeometry x="20" y="569" width="520" height="84" as="geometry"/></mxCell><mxCell id="c39" value="Détail des tables, fonctions et accès dans l’onglet 5." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fillColor=none;" vertex="1" parent="c32"><mxGeometry x="20" y="663" width="520" height="24" as="geometry"/></mxCell><mxCell id="c40" value="Appelés par le Worker (e-mails, paiements)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="631" width="230" height="203" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;api.resend.com : e-mails transactionnels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;" vertex="1" parent="c40"><mxGeometry x="10" y="38" width="210" height="65" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;api.stripe.com : Checkout (abonnement Premium) et webhook signé vers /api/stripe-webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;arcSize=6;fontSize=10;" vertex="1" parent="c40"><mxGeometry x="10" y="113" width="210" height="78" as="geometry"/></mxCell><mxCell id="c43" value="Appelés directement par le navigateur" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#E1D5E7;strokeColor=#9673A6;swimlane
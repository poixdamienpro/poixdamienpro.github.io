xCell id="c2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Front — fichiers JavaScript et leurs fonctions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666666&quot;&gt;31 fichiers · 360 fonctions de premier niveau. Chaque carte : rôle, liste des fonctions, puis ce qu’elle appelle côté Supabase / Worker.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="52" as="geometry"/></mxCell><mxCell id="c3" value="data.js (1)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;startSize=28;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="250" height="147.6" as="geometry"/></mxCell><mxCell id="c4" value="&lt;i&gt;Constantes et état global : SUPABASE_URL (= /api du Worker), clé anon publique, plans Premium, FAQ, clé Web3Forms, listes COMPANIES / PRODUCTS / INDUSTRIES.&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;fontColor=#444444;" vertex="1" parent="c3"><mxGeometry x="4" y="30" width="242" height="60" as="geometry"/></mxCell><mxCell id="c5" value="sendTransactionalEmail()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c3"><mxGeometry x="4" y="90" width="188" height="24.6" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Appelle :&lt;/b&gt; Worker /api/send-email" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;fontColor=#2E7D32;fontSize=9;" vertex="1" parent="c3"><mxGeometry x="4" y="114.6" width="242" height="23" as="geometry"/></mxCell><mxCell id="c7" value="api.js (14)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;startSize=28;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="250" height="363.4" as="geometry"/></mxCell><mxCell id="c8" value="&lt;i&gt;Client REST Supabase : pagination par pages de 50, RPC, chargement du catalogue (loadTaxonomy), logos, message d’erreur réseau avec « Réessayer ».&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;fontColor=#444444;" vertex="1" parent="c7"><mxGeometry x="4" y="30" width="242" height="60" as="geometry"/></mxCell><mxCell id="c9" value="escapeHtml()&lt;br&gt;escapeJsAttr()&lt;br&gt;supabase()&lt;br&gt;fetchAllPaged()&lt;br&gt;fetchAllPagedTable()&lt;br&gt;fetchRpc()&lt;br&gt;fetchOne()&lt;br&gt;mapCompany()&lt;br&gt;companyDomain()&lt;br&gt;companyLogoHtml()&lt;br&gt;mapProduct()&lt;br&gt;loadTaxonomy()&lt;br&gt;showLoading()&lt;br&gt;showLoadError()" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;whiteSpace=nowrap;" vertex="1" parent="c7"><mxGeometry x="4" y="90" width="188" height="188.4" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Appelle :&lt;/b&gt; RPC get_companies_page, get_products_page · tables company_tags, company_product_categories, company_industries, company_locations, product_characteristics, product_tags" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontSize=10;spacing=4;fontColor=#2E7D32;fontSize=9;" vertex="1" parent="c7"><mxGeometry x="4" y="278.4" width="242" height="75" as="geometry"/></mxCell><mxCell id="c11" value="i18n.js (12)" style="swimlane;fontStyle=1;childLayout=;horizontal=1;startSize=30;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=13;collapsible=0;startSize